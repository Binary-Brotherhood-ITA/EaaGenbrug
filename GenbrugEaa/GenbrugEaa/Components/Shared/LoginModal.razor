@using GenbrugEaa.Services
@inject NavigationManager nav
@inject LoginService login

@if(!isLoggedIn)
{
    <button class="btn btn-primary" @onclick="OpenLoginModal">
        Log ind
    </button>
} else
{
    <button class="btn btn-primary" @onclick="OnClickLogout">
        Log ud
    </button>
}


@if (showLoginModal)
{
    <div class="modal-overlay" @onclick="CloseLoginModal">
        <div class="modal-content" @onclick:stopPropagation="true">

            <h4>Log ind</h4>

            <InputText @bind-Value="username"
                       class="form-control mb-2"
                       placeholder="Indtast brugernavn" />

            <InputText type="password"
                       @bind-Value="password"
                       class="form-control mb-2"
                       placeholder="Indtast password" />

            @if (!string.IsNullOrEmpty(errorText))
            {
                <div class="error-message">
                    ⚠️ @errorText
                </div>
            }

            <button class="btn btn-primary" @onclick="OnClickLogin">
                Log ind
            </button>

            <button class="btn btn-secondary" @onclick="CloseLoginModal">
                Annuller
            </button>
        </div>
    </div>
}

@code {
    private string username = "";
    private string password = "";
    private string errorText = "";
    bool isLoggedIn = false;

    private bool showLoginModal = false;

    // Kalder LoginService.IsLoggedIn for at tjekke om bruger er logget ind eller ud ifølge sessionStorage.
    protected override async Task OnInitializedAsync()
    {
        isLoggedIn = await login.IsLoggedIn();
    }

    // Åbner modal vindue
    private void OpenLoginModal()
    {
        showLoginModal = true;
    }

    // Lukker modal vindue
    private void CloseLoginModal()
    {
        showLoginModal = false;
        errorText = "";
    }

    /* OnClickLogin():
     * Kalder LoginService.UserLogin for at finde match med username && password i backend. 
     * Hvis der findes et match, returneres User.UserId og det første ord i User.Name
     * Hvis true, kaldes LoginService.SetUserSession og modal vinduet lukker. 
     * Nødt til at skrive userId.Value, fordi LoginService forventer en int -- .Value beregner heltalsværdien int-værdien. 
     */
    
    private async Task OnClickLogin()
    {
        (int? userId, string firstName) = await login.UserLogin(username, password);

        if (userId != null && username != null)
        {
            await login.SetUserSession(userId.Value, username, firstName);
            isLoggedIn = true;
            CloseLoginModal();
            nav.NavigateTo("/");
        }
        else
        {
            errorText = "Forkert brugernavn eller password";
        }
    }

    // kalder LoginService.Logout
    private async Task OnClickLogout()
    {
        await login.Logout();
        isLoggedIn = false;
    }
}