@page "/shoppinglist"
@inject HttpClient Http
@inject LoginService login
@using Core

<div class="mb-4">
    <button class="btn @(showRequests ? "btn-outline-primary" : "btn-primary") me-2"
            @onclick="() => showRequests = false">
        Mine indkøb
    </button>

    <button class="btn @(showRequests ? "btn-primary" : "btn-outline-primary")"
            @onclick="() => showRequests = true">
        Sendte anmodninger
    </button>
</div>


<p>@message</p>

@if (!showRequests)
{

    <h3>Mine indkøb</h3>
    
    @if (ads.Count == 0)
    {
        <p>Din indkøbsliste er tom.</p>
    }
    else
    {
        // UC-04: Viser annoncerne fra indkøbslisten
        @foreach (Ad ad in ads)
        {
            <div class="card mb-3">
                <div class="card-body">
                    <h5>@ad.Name</h5>

                    <p>Pris: @ad.Price kr.</p>

                    <p>Beskrivelse: @ad.Description</p>

                    <p>Stand: @ad.Condition</p>

                    @if (ad.Status == "Active")
                    {

                        <button class="btn btn-success"
                                disabled="@sentRequests.Contains(ad.Id)"
                                @onclick="() => SendRequest(ad.Id)">

                            @if (sentRequests.Contains(ad.Id))
                            {
                                <text>Købsanmodning sendt</text>
                            }
                            else
                            {
                                <text>Send købsanmodning</text>
                            }
                        </button>

                    }
                    else
                    {
                        <p>Varen er ikke tilgængelig for køb.</p>
                    }
                    <button class="btn btn-danger ms-2"
                            @onclick="() => RemoveFromShoppingList(ad.Id)">
                        Fjern fra indkøbsliste
                    </button>


                </div>
            </div>
        }
    }
}

@if (showRequests)
    {
        <h3 class="mt-4">Mine købsanmodninger</h3>

        @if (requests.Count == 0)
        {
            <p>Du har ingen købsanmodninger.</p>
        }
        else
        {
            <h4>Afventende</h4>


            @if (pendingRequests.Count == 0)
            {
                <p>Du har ingen afventende købsanmodninger.</p>
            }

            // UC-07: Viser brugerens købsanmodninger
            @foreach (PurchaseRequest request in pendingRequests)
            {
                <div class="card mb-3">
                    <div class="card-body">

                        @if (requestAds.TryGetValue(request.AdId, out Ad? ad))
                        {
                            <h5>@ad.Name</h5>
                            <p>Pris: @ad.Price kr.</p>
                        }
                        else
                        {
                            <h5>Annonce @request.AdId er slettet</h5>
                        }

                        <p>Sælger: @sellerNames.GetValueOrDefault(request.SellerId, "Ukendt sælger")</p>

                        @if (request.Status == "Pending")
                        {
                            <p>Status: Afventer</p>
                        }
                        else if (request.Status == "accepted")
                        {
                            <p>Status: Accepteret</p>
                        }
                        else if (request.Status == "declined")
                        {
                            <p>Status: Afvist</p>
                        }

                        <p>Sendt den: @request.CreatedAt.ToLocalTime().ToString("dd.MM.yyyy 'kl.' HH:mm")</p>
                        
                        <button class="btn btn-danger mt-2"
                                @onclick="() => CancelRequest(request)">
                            Annuller købsanmodning
                        </button>


                        @if (request.Status == "accepted" && request.StatusChangeDate.HasValue)
                        {
                            <p>Accepteret
                                den: @request.StatusChangeDate.Value.ToLocalTime().ToString("dd.MM.yyyy 'kl.' HH:mm")</p>
                        }

                        @if (request.Status == "declined" && request.StatusChangeDate.HasValue)
                        {
                            <p>Afvist
                                den: @request.StatusChangeDate.Value.ToLocalTime().ToString("dd.MM.yyyy 'kl.' HH:mm")</p>
                        }
                        
                        @if (request.Status == "cancelled" && request.StatusChangeDate.HasValue)
                        {
                            <p>Annulleret den: @request.StatusChangeDate.Value.ToLocalTime().ToString("dd.MM.yyyy 'kl.' HH:mm")</p>
                        }
                        
                    </div>
                </div>
            }

            <h4 class="mt-4">Afsluttede</h4>

            @if (finishedRequests.Count == 0)
            {
                <p>Du har ingen afsluttede købsanmodninger.</p>
            }

            @foreach (PurchaseRequest request in finishedRequests)
            {
                <div class="card mb-3">
                    <div class="card-body">

                        @if (requestAds.TryGetValue(request.AdId, out Ad? ad))
                        {
                            <h5>@ad.Name</h5>
                            <p>Pris: @ad.Price kr.</p>
                        }
                        else
                        {
                            <h5>Annonce @request.AdId er slettet</h5>
                        }

                        <p>Sælger: @sellerNames.GetValueOrDefault(request.SellerId, "Ukendt sælger")</p>

                        @if (request.Status == "accepted")
                        {
                            <p>Status: Accepteret</p>
                        }
                        else if (request.Status == "declined")
                        {
                            <p>Status: Afvist</p>
                        }
                        else if (request.Status == "cancelled")
                        {
                            <p>Status: Annulleret</p>
                        }
                        
                        <p>Sendt den: @request.CreatedAt.ToLocalTime().ToString("dd.MM.yyyy 'kl.' HH:mm")</p>

                        @if (request.Status == "accepted" && request.StatusChangeDate.HasValue)
                        {
                            <p>Accepteret den: @request.StatusChangeDate.Value.ToLocalTime().ToString("dd.MM.yyyy 'kl.' HH:mm")</p>
                        }

                        @if (request.Status == "declined" && request.StatusChangeDate.HasValue)
                        {
                            <p>Afvist den: @request.StatusChangeDate.Value.ToLocalTime().ToString("dd.MM.yyyy 'kl.' HH:mm")</p>
                        }

                        @if (request.Status == "cancelled" && request.StatusChangeDate.HasValue)
                        {
                            <p>Annulleret den: @request.StatusChangeDate.Value.ToLocalTime().ToString("dd.MM.yyyy 'kl.' HH:mm")</p>
                        }

                    </div>
                </div>
            }
            
        }

    }

@code {
    
    // Styrer om vi viser indkøbslisten eller købsanmodningerne
    private bool showRequests = false;

    // UC-04: Brugerens indkøbsliste
    private ShoppingList? shoppingList;
    
    // UC-04: Gemmer annoncerne fra indkøbslisten
    private List<Ad> ads = new List<Ad>();
    
    // UC-07: Gemmer brugerens købsanmodninger
    private List<PurchaseRequest> requests = new List<PurchaseRequest>();
    
    // UC-07: Købsanmodninger der afventer svar
    private List<PurchaseRequest> pendingRequests = new List<PurchaseRequest>();

    // UC-07: Købsanmodninger der er behandlet
    private List<PurchaseRequest> finishedRequests = new List<PurchaseRequest>();

    // UC-07: Gemmer sælgernes navne
    private Dictionary<int, string> sellerNames = new Dictionary<int, string>();
    
    // UC-07: Gemmer annoncerne fra købsanmodningerne
    private Dictionary<int, Ad> requestAds = new Dictionary<int, Ad>();

    // Midlertidig testbruger
    private int userId;

    // UC-04: Henter indkøbslisten fra API
    protected override async Task OnInitializedAsync()
    {
        // UC-01: Henter den indloggede bruger
        bool isLoggedIn = await login.IsLoggedIn();

        if (!isLoggedIn)
        {
            message = "Du skal logge ind for at se dine indkøb.";
            return;
        }

        userId = await login.GetUserId();

        try
        {
            shoppingList = await Http.GetFromJsonAsync<ShoppingList>(
                $"api/shoppinglist/{userId}");
           
            // UC-04: Henter oplysninger om hver annonce
            if (shoppingList != null)
            {
                foreach (int adId in shoppingList.AdIds)
                {
                    Ad? ad = await Http.GetFromJsonAsync<Ad>(
                        $"api/ad/{adId}");

                    if (ad != null)
                    {
                        ads.Add(ad);
                    }
                }
            }
        }
        catch (HttpRequestException)
        {
            shoppingList = null;
        }
        
        // UC-07: Henter brugerens købsanmodninger
        try
        {
            requests = await Http.GetFromJsonAsync<List<PurchaseRequest>>(
                $"api/purchaserequest/buyer/{userId}") ?? new List<PurchaseRequest>();
        }
       
        catch (HttpRequestException ex)
        {
            message = "Fejl ved hentning: " + ex.Message;
            requests = new List<PurchaseRequest>();
        }
        
        // UC-07: Fordeler købsanmodninger efter status
        foreach (PurchaseRequest request in requests)
        {
            if (request.Status == "Pending")
            {
                pendingRequests.Add(request);
            }
            
            else if (request.Status == "accepted" ||
                     request.Status == "declined" ||
                     request.Status == "cancelled")
            {
                finishedRequests.Add(request);
            }
        }
        
        // UC-07: Henter sælgernes navne
        foreach (PurchaseRequest request in requests)
        {
            if (!sellerNames.ContainsKey(request.SellerId))
            {
                try
                {
                    User? seller = await Http.GetFromJsonAsync<User>(
                        $"api/user/{request.SellerId}");

                    sellerNames[request.SellerId] = seller?.Name ?? "Ukendt sælger";
                }
                catch (HttpRequestException)
                {
                    sellerNames[request.SellerId] = "Ukendt sælger";
                }
            }
        }
        
        // UC-07: Henter annoncerne til købsanmodningerne
        foreach (PurchaseRequest request in requests)
        {
            if (!requestAds.ContainsKey(request.AdId))
            {
                try
                {
                    Ad? ad = await Http.GetFromJsonAsync<Ad>(
                        $"api/ad/{request.AdId}");

                    if (ad != null)
                    {
                        requestAds.Add(request.AdId, ad);
                    }
                }
                catch (HttpRequestException)
                {
                    // Annoncen kan være slettet
                }
            }
        }

    }
    
    // UC-05: Sender en købsanmodning
    private async Task SendRequest(int adId)
    {
        HttpResponseMessage response = await Http.PostAsync(
            $"api/PurchaseRequest/send/{adId}/{userId}", null);

       
        if (response.IsSuccessStatusCode)
        {
            // UC-05: Husker at købsanmodningen er sendt
            sentRequests.Add(adId);

            message = "Købsanmodningen er sendt.";
        }

        else
        {
            message = "Købsanmodningen kunne ikke sendes.";
        }
    }
    
    private string message = "";
    
    // UC-05: Gemmer ID på annoncer, hvor købsanmodningen er sendt
    private List<int> sentRequests = new List<int>();
    
    // UC-06: Fjerner en annonce fra indkøbslisten
    private async Task RemoveFromShoppingList(int adId)
    {
        HttpResponseMessage response = await Http.DeleteAsync(
            $"api/shoppinglist/{userId}/ads/{adId}");

        if (response.IsSuccessStatusCode)
        {
            ads.RemoveAll(ad => ad.Id == adId);
            message = "Annoncen er fjernet fra indkøbslisten.";
        }
        else
        {
            message = "Annoncen kunne ikke fjernes.";
        }
    }
    
    // UC-07: Annullerer en afventende købsanmodning
    private async Task CancelRequest(PurchaseRequest request)
    {
        HttpResponseMessage response = await Http.PutAsync(
            $"api/purchaserequest/{request.Id}/cancel/{userId}", null);

        if (response.IsSuccessStatusCode)
        {
            request.Status = "cancelled";
            pendingRequests.Remove(request);
            finishedRequests.Add(request);

            message = "Købsanmodningen er annulleret.";
        }
        else
        {
            message = "Købsanmodningen kunne ikke annulleres.";
        }
    }


}

