@page "/info"

<h3 class="pageTitle">Information</h3>

<div class="info-page">

    <h3 class="pageSubTitle">Opbevaring af varer</h3>

    <section class="welcome-section">
        <p><strong>Hvor kan du afhente din købte vare? 📦</strong></p>
        <p>Her finder du information om de tre lokaler, hvor genbrugsvarer kan opbevares på EAAA</p>
    </section>

    <section class="location-menu">
        <!-- Lokale 1 -->
        <div class="location-card">
            <img src="data/stock_images/Basement.jpg" alt="Basement" />

            <div class="location-card-content">
                <h4>Basement</h4>
                <div class="location-info">
                    <strong>Åbningstider:</strong>
                    <div class="opening-hours">
                        <span>Mandag-fredag</span>
                        <span>8:00-16:00</span>
                    </div>
                </div>
                <div class="location-info">
                    <strong>Bemanding:</strong> 
                    <div class="opening-hours">
                        <span>Fredag fra kl. 11:30-23:00</span>
                        <span>8:00-16:00</span>
                    </div>
                </div>
            </div>
        </div>
        <!-- Lokale 2 -->
        <div class="location-card">
            <img src="data/stock_images/StudyHub.jpg" alt="StudyHub" />

            <div class="location-card-content">
                <h4>StudyHub</h4>
                <div class="location-info">
                    <strong>Åbningstider:</strong>
                    <div class="opening-hours">
                        <span>Mandag-torsdag</span>
                        <span>8:30-16:00</span>
                        <span>Fredag</span>
                        <span>8:30-14:00</span>
                    </div>
                </div>
                <div class="location-info">
                    <strong>Bemanding:</strong> 
                    <div class="opening-hours">
                        <span>Mandag-torsdag</span>
                        <span>8:30-14:00</span>
                        <span>Fredag</span>
                        <span>8:30-12:00</span>
                    </div>
                </div>
            </div>
        </div>

        <!-- Lokale 3 -->
        <div class="location-card">
            <img src="data/stock_images/A2-02.jpg" alt="A2.02" />

            <div class="location-card-content">
                <h4>A2.02</h4>
                <div class="location-info">
                    <strong>Åbningstider:</strong>
                    <div class="opening-hours">
                        <span>Mandag-fredag</span>
                        <span>8:30-16:00</span>
                    </div>
                </div>
                <div class="location-info">
                    <strong>Bemanding:</strong> 
                    <div class="opening-hours">
                        <span>Ubemandet</span>
                    </div>
                </div>
            </div>
        </div>

    </section>

</div>

@code {

}
