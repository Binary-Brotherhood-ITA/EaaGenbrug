@page "/myads"
@using Core
@using Blazored.SessionStorage
@using System.Net.Http.Json
@inject NavigationManager nav
@inject ISessionStorageService sessionStorage
@inject HttpClient Http

<PageTitle>Opret annonce</PageTitle>

<h1>Opret annonce</h1>
<p>Udfyld oplysningerne om den vare, du vil sælge.</p>

@if (!isLoaded)
{
    <p>Indlæser...</p>
}
else if (loggedIn)
{
    <!-- Formular til oprettelse af en ny annonce -->
    <section class="create-ad-panel">

        <EditForm Model="@newAd"
                  OnValidSubmit="HandleCreateSubmit"
                  FormName="CreateAdForm">

            <DataAnnotationsValidator />
            <ValidationSummary />

            <!-- Viser ID på den indloggede sælger -->
            <div class="mb-3">
                <label>Sælger ID</label>
                <input class="form-control"
                       value="@sellerId"
                       readonly />
            </div>

            <!-- Annoncens navn -->
            <div class="mb-3">
                <label>Navn på vare</label>
                <InputText @bind-Value="newAd.Name"
                           class="form-control"
                           placeholder="F.eks. Studiecomputer" />
            </div>

            <!-- Annoncens pris -->
            <div class="mb-3">
                <label>Pris (kr.)</label>
                <InputNumber @bind-Value="newAd.Price"
                             class="form-control" />
            </div>

            <!-- Vælg kategori -->
            <div class="mb-3">
                <label>Kategori</label>
                <InputSelect @bind-Value="newAd.Category"
                             class="form-select">
                    <option value="">Vælg kategori</option>

                    @foreach (string category in categories)
                    {
                        <option value="@category">@category</option>
                    }
                </InputSelect>
            </div>

            <!-- Beskrivelse af varen -->
            <div class="mb-3">
                <label>Beskrivelse</label>
                <InputTextArea @bind-Value="newAd.Description"
                               class="form-control"
                               placeholder="Beskriv varen..." />
            </div>

            <!-- Billedsti eller billedlink -->
            <div class="mb-3">
                <label>Billedlink</label>
                <InputText @bind-Value="newAd.ImgPath"
                           class="form-control"
                           placeholder="https://example.com/image.jpg" />
            </div>

            <!-- Vælg varens stand -->
            <div class="mb-3">
                <label>Stand</label>
                <InputSelect @bind-Value="newAd.Condition"
                             class="form-select">
                    <option value="">Vælg stand</option>

                    @foreach (string condition in conditions)
                    {
                        <option value="@condition">@condition</option>
                    }
                </InputSelect>
            </div>

            <!-- Valgfrit lokations-ID -->
            <div class="mb-3">
                <label>Lokation ID (valgfrit)</label>
                <InputNumber @bind-Value="newAd.LocationId"
                             class="form-control" />
            </div>

            <!-- Vælg om annoncen skal være aktiv -->
            <div class="mb-3">
                <label>Status</label>
                <InputSelect @bind-Value="newAd.Status"
                             class="form-select">
                    <option value="Active">Aktiv</option>
                    <option value="Inactive">Inaktiv</option>
                </InputSelect>
            </div>

            <!-- Knapper til at gemme eller rydde formularen -->
            <div class="mb-3">
                <button type="submit" class="btn btn-primary">
                    Opret annonce
                </button>

                <button type="button"
                        class="btn btn-secondary"
                        @onclick="ResetCreateForm">
                    Ryd felter
                </button>
            </div>

        </EditForm>
    </section>

    <!-- Viser besked efter oprettelse -->
    @if (!string.IsNullOrWhiteSpace(createStatus))
    {
        <p role="status">@createStatus</p>
    }
}

@code {

    // Holder siden skjult indtil login er kontrolleret
    private bool isLoaded = false;
    private bool loggedIn = false;

    // ID på den indloggede sælger
    private int? sellerId = null;

    // Objektet som formularen udfylder
    private Ad newAd = new Ad { Status = "Active" };

    // Besked efter oprettelse
    private string createStatus = "";

    // Kategorier som brugeren kan vælge
    private List<string> categories = new()
    {
        "Books",
        "Electronics",
        "Clothing",
        "Furniture",
        "Other"
    };

    // Mulige tilstande for varen
    private List<string> conditions = new()
    {
        "Ny",           // Helt ny og ubrugt
        "Rigtig god",     // Meget god stand
        "God",          // God stand med få brugsspor
        "Brugt",          // Brugt med tydelige brugsspor
        
    };


    
    // Henter oplysninger når siden åbnes
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
        {
            return;
        }

        // Midlertidig testbruger
        sellerId = 1;
        loggedIn = true;

        // Tilknytter sælgeren til annoncen
        newAd.SellerId = (int)sellerId;

        // Viser formularen
        isLoaded = true;
        StateHasChanged();

        await Task.CompletedTask;
    }
    


    // UC-08: Opretter en ny annonce
    private async Task HandleCreateSubmit()
    {
        // Tjekker om sælger-ID findes
        if (sellerId == null || sellerId <= 0)
        {
            createStatus = "Sælger-ID mangler.";
            return;
        }

        // Tjekker obligatoriske oplysninger
        if (string.IsNullOrWhiteSpace(newAd.Name) ||
            string.IsNullOrWhiteSpace(newAd.Category) ||
            string.IsNullOrWhiteSpace(newAd.Description) ||
            string.IsNullOrWhiteSpace(newAd.Condition))
        {
            createStatus = "Udfyld alle obligatoriske felter.";
            return;
        }

        // Prisen må ikke være negativ
        if (newAd.Price < 0)
        {
            createStatus = "Prisen må ikke være negativ.";
            return;
        }

        // Tilknytter sælgeren til annoncen
        newAd.SellerId = (int)sellerId;

        try
        {
            // POST sender annoncen til AdController
            HttpResponseMessage response =
                await Http.PostAsJsonAsync("api/ad", newAd);

            // Tjekker om annoncen blev oprettet
            if (response.IsSuccessStatusCode)
            {
                ResetCreateForm();

                createStatus = "Annoncen er oprettet!";
            }
            else
            {
                createStatus = "Annoncen kunne ikke oprettes.";
            }
        }
        catch (HttpRequestException)
        {
            // Viser fejl hvis forbindelsen til backend fejler
            createStatus = "Kunne ikke forbinde til serveren.";
        }
    }


    // Nulstiller formularen efter oprettelse
    private void ResetCreateForm()
    {
        // Opretter et nyt tomt annonceobjekt
        newAd = new Ad { Status = "Active" };

        // Beholder den indloggede sælger
        if (sellerId != null)
        {
            newAd.SellerId = (int)sellerId;
        }

        createStatus = "";
    }
}
