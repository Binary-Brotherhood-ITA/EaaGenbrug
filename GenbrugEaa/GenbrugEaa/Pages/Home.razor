
@page "/"

<PageTitle>Home</PageTitle>

<div class="home-page">

    <h3 class="pageTitle">GenbrugsMarked EAAA</h3>

    <section class="welcome-section">
        <h4>Velkommen til EAAA's GenbrugsMarked 👋</h4>

        <p class="welcome-subtitle">
            En fælles platform til genbrugsvarer for lærere og studerende.
        </p>

        <p>
            Her kan du købe og sælge brugte varer og give ting nyt liv
            gennem genbrug på tværs af EAAA.
        </p>

        <p class="login-reminder">
            Husk at logge ind for at få adgang til alle funktionerne! 🙂
        </p>
    </section>


    <section class="home-menu">

        <div class="home-card">
            <h4>Mine annoncer</h4>

            <p class="home-card-subtitle">
                Sæt dine ting til salg.
            </p>

            <p>
                Her kan du oprette og redigere dine annoncer samt
                acceptere og afvise købsanmodninger på dine annoncer.
            </p>
        </div>


        <div class="home-card">
            <h4>Marked</h4>

            <p class="home-card-subtitle">
                Gå på jagt blandt alle aktive annoncer.
            </p>

            <p>
                Her kan du finde det, du ikke vidste, du gik og manglede.
                Du kan se detaljer om annoncer og tilføje dem til din egen
                indkøbsside for at få et samlet overblik.
            </p>
        </div>


        <div class="home-card">
            <h4>Mine indkøb</h4>

            <p class="home-card-subtitle">
                Få overblik over annoncer og send købsanmodninger.
            </p>

            <p>
                Her kan du få et overblik over de annoncer, du er
                interesseret i. Du kan sende købsanmodninger til sælger
                og se status på tidligere sendte købsanmodninger.
            </p>
        </div>

    </section>

</div>
